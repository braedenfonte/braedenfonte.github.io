  "name": "Pamukkale",
  "wiki": "Pamukkale",
  "country": "Turkey",
  "region": "Denizli Province, Inner Aegean",
  "lat": 37.9239,
  "lon": 29.1233,
  "tagline": "White travertine terraces filled with warm mineral water",
  "intro": "Pamukkale is a hillside of white travertine terraces in southwestern Turkey, built up by hot springs rich in calcium. Above it sit the ruins of the ancient spa city of Hierapolis. The two together are a UNESCO World Heritage Site.",
  "stats": [
   {
    "label": "Terrace length",
    "value": "about 2,700 m"
   },
   {
    "label": "Terrace height",
    "value": "about 160 m"
   },
   {
    "label": "UNESCO listing",
    "value": "1988"
   },
   {
    "label": "Hot springs",
    "value": "17, 35–100 °C"
   }
  ],
  "facts": [
   "The travertine formation is about 2,700 m long, 600 m wide and 160 m high, visible from Denizli about 20 km away.",
   "It is fed by 17 hot springs with temperatures between 35 °C and 100 °C.",
   "Hierapolis was founded as a thermal spa in the early 2nd century BC.",
   "Cleopatra's Pool is a thermal pool where ancient marble columns lie submerged.",
   "More than two million people visit each year, and sections are periodically closed so the terraces can regenerate."
  ],
  "bestTime": "Spring and autumn for mild weather; go early or late in the day to avoid crowds",
  "gettingThere": "Fly New York to Istanbul, then connect to Denizli (Çardak) airport and drive about 1 hour; or take a bus or taxi from Denizli.",
  "tip": "Walk the terraces barefoot where allowed, and visit the Hierapolis ruins above them."
 },
