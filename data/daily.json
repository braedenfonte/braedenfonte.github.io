 "location": {
  "name": "Antelope Canyon",
  "wiki": "Antelope_Canyon",
  "country": "United States",
  "region": "Navajo Nation, Coconino County, Arizona",
  "lat": 36.861964,
  "lon": -111.374342,
  "tagline": "Twisting sandstone slot canyons carved by flash floods",
  "intro": "Antelope Canyon is a pair of narrow slot canyons on Navajo land just outside Page, Arizona. Flash floods carved the red Navajo Sandstone into smooth, wave-like walls that glow when sunlight filters down from above. It's one of the most photographed places in the American Southwest.",
  "stats": [
   {
    "label": "Upper canyon length",
    "value": "about 660 ft"
   },
   {
    "label": "Lower canyon length",
    "value": "about 1,335 ft"
   },
   {
    "label": "Depth",
    "value": "about 120 ft"
   },
   {
    "label": "Floor elevation",
    "value": "3,704 ft"
   }
  ],
  "facts": [
   "The Navajo call Upper Antelope Canyon Tsé bighánílíní, meaning 'the place where water runs through rocks.'",
   "Lower Antelope Canyon's Navajo name, Hazdistazí, means 'spiral rock arches.'",
   "The canyons were formed by flash floods eroding Navajo Sandstone, and floods still reshape them today.",
   "On August 12, 1997, a flash flood killed 11 tourists in Lower Antelope Canyon.",
   "Since 1997 it has been a Navajo Tribal Park, and you can only enter with an authorized Navajo guide."
  ],
  "bestTime": "Spring through early fall for the famous midday light beams in Upper Antelope Canyon; tours close whenever flash-flood risk is high.",
  "gettingThere": "Fly from NYC to Phoenix (PHX) or Las Vegas (LAS), then drive about 4.5 hours to Page, Arizona. Book a guided tour in advance.",
  "tip": "Book a late-morning Upper Canyon tour for the light beams, or Lower Canyon if you'd rather climb ladders and see fewer crowds."
 },
