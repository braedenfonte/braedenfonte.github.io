 "location": {
  "name": "Lençóis Maranhenses National Park",
  "wiki": "Lençóis_Maranhenses_National_Park",
  "country": "Brazil",
  "region": "Maranhão, northeastern Brazil",
  "lat": -2.53,
  "lon": -43.12,
  "tagline": "A white-sand dune field that fills with rainwater lagoons every year.",
  "intro": "Lençóis Maranhenses looks like a desert, but it gets about 1,200 mm of rain a year. Each rainy season, water collects between the dunes and an impermeable rock layer under the sand keeps it from draining, creating thousands of blue-green freshwater lagoons. It was declared a UNESCO World Heritage Site in July 2024.",
