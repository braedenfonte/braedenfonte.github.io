 "location": {
  "name": "Uluru",
  "wiki": "Uluru",
  "country": "Australia",
  "region": "Uluṟu-Kata Tjuṯa National Park, Northern Territory",
  "lat": -25.345,
  "lon": 131.036,
  "tagline": "A sandstone monolith that glows red in the middle of the Australian outback.",
  "intro": "Uluru, also known as Ayers Rock, is a huge sandstone monolith rising from the flat desert of central Australia, about 335 km south-west of Alice Springs. Sacred to the Aṉangu people, it is the centerpiece of Uluṟu-Kata Tjuṯa National Park, a UNESCO World Heritage Site, and famous for turning a fiery red at sunrise and sunset.",
  "stats": [
   {
    "label": "Height above plain",
    "value": "≈348 m (1,142 ft)"
   },
   {
    "label": "Perimeter",
    "value": "9.4 km (5.8 mi)"
   },
   {
    "label": "Rock age",
    "value": "≈550–530 million years"
   },
   {
    "label": "UNESCO World Heritage",
    "value": "Since 1987"
   }
  ],
  "facts": [
   "Most of Uluru is hidden: the rock layers continue below the surrounding plain, and their full underground extent is unknown.",
   "Its red glow comes from iron oxide — essentially rust — in the outer layer of the feldspar-rich sandstone.",
   "Some visitors who took pieces of the rock have mailed them back, convinced the souvenirs brought them bad luck.",
   "Climbing Uluru has been banned since 26 October 2019, exactly 34 years after the land was handed back to its traditional owners in 1985.",
   "During rare heavy rain, temporary waterfalls pour down the sides of the rock."
  ],
  "bestTime": "May–September (the southern winter) for mild days; summer often brings extreme heat and some trails close early in the day.",
  "gettingThere": "No nonstop from New York: fly to Sydney or Melbourne (usually one stop via the West Coast), then take a domestic flight to Ayers Rock Airport near Yulara, a short drive from the park.",
  "tip": "Save time for Kata Tjuṯa, 25 km west — its domed rock formations are just as striking and see far fewer visitors than Uluru."
 },
