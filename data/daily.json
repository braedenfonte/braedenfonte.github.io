 "location": {
  "name": "Cappadocia",
  "wiki": "Cappadocia",
  "country": "Turkey",
  "region": "Central Anatolia (Nevşehir Province)",
  "lat": 38.65,
  "lon": 34.86,
  "tagline": "A volcanic dreamscape of fairy chimneys, cave churches and cities carved deep underground.",
  "intro": "Cappadocia is a historical region of Central Anatolia, where millions of years of erosion carved thick volcanic tuff into cliffs, pillars and 'fairy chimneys.' People have hollowed homes, monasteries and entire underground cities out of the soft rock, and at sunrise the valleys around Göreme fill with hot-air balloons. Its heart is protected as the UNESCO site Göreme National Park and the Rock Sites of Cappadocia.",
  "stats": [
   {
    "label": "UNESCO World Heritage",
    "value": "Since 1985 (mixed site)"
   },
   {
    "label": "Göreme park area",
    "value": "9,884 ha (≈99 km²)"
   },
   {
    "label": "Tallest peak nearby",
    "value": "Mount Erciyes, 3,916 m"
   },
   {
    "label": "Visitors",
    "value": "≈2–4 million a year"
   }
  ],
  "facts": [
   "The landscape was built by eruptions of Mount Erciyes, Mount Hasan and Göllüdağ, whose ash hardened into tuff roughly 9 to 3 million years ago; harder caps of rock protect the chimneys beneath them from erosion.",
   "The underground city of Derinkuyu was rediscovered in 1963 when a resident knocked down a basement wall; it reaches about 280 feet down across at least 18 levels and could shelter up to 20,000 people.",
   "Derinkuyu breathed through a main shaft plus more than 50 ventilation shafts, and huge stone doors could seal off its passages during attacks.",
