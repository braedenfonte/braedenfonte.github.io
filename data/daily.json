 "location": {
  "name": "Tsingy de Bemaraha",
  "wiki": "Tsingy_de_Bemaraha_Strict_Nature_Reserve",
  "country": "Madagascar",
  "region": "Melaky Region, western Madagascar",
  "lat": -18.8,
  "lon": 44.7,
  "tagline": "A forest of limestone needles above the Manambolo River",
  "intro": "Tsingy de Bemaraha is a nature reserve and national park on Madagascar's western side, known for needle-shaped limestone formations that rise above cliffs over the Manambolo River. It was made a UNESCO World Heritage Site in 1990.",
  "stats": [
   {
    "label": "Reserve area",
    "value": "834.11 km²"
   },
   {
    "label": "Reserve established",
    "value": "1927"
   },
   {
    "label": "UNESCO listed",
    "value": "1990"
   },
   {
    "label": "Distance from Morondava",
    "value": "about 150 km"
   }
  ],
  "facts": [
   "'Tsingy' comes from a local phrase meaning 'the place where one cannot walk barefoot.'",
   "The limestone pinnacles are so sharp they can cut through equipment and flesh.",
   "The strict nature reserve was established on 31 December 1927.",
   "In 1997 the southern end became Tsingy de Bemaraha National Park, while the northern end stayed a strict nature reserve.",
   "UNESCO cites its geography, preserved mangrove forests, and wild bird and lemur populations."
  ],
  "bestTime": "The dry season, roughly May to November (sources vary on the start month). Heavy rain from about December to March makes roads impassable and the park shuts.",
  "gettingThere": "Fly from New York to Antananarivo (usually with connections), then reach Morondava and drive about 150 km by 4x4. Limited access is also possible via Antsalova, which has flights from Antananarivo or Mahajanga.",
  "tip": "Hire a local guide and operator, and check road and park status before you go; the track is unpaved with river crossings."
 },
